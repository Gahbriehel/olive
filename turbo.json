{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {},
    "check-types": {},
    "format": {
      "cache": false
    },
    "check-all": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
