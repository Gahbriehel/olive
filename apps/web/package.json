{
  "name": "@olive/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint .",
    "check-types": "tsc --pretty --noEmit",
    "format": "prettier --ignore-path ../../.prettierignore --write .",
    "check-format": "prettier --ignore-path ../../.prettierignore --check .",
